generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Program {
  id          String   @id @default(cuid())
  title       String
  startTime   DateTime
  endTime     DateTime
  location    String?
  description String?
  priority    String
  status      String   @default("EN_ATTENTE")
  originalId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id                  String   @id @default("default-settings")
  tone                String   @default("MASCULIN")
  title               String   @default("Mr")
  audioEnabled        Boolean  @default(true)
  beepSound           String   @default("MODERNE")
  language            String   @default("FR")
  theme               String   @default("CLAIR")
  viewType            String   @default("LISTE")
  morningReminderTime String   @default("05:15")
  eveningSummaryTime  String   @default("19:30")
  updatedAt           DateTime @updatedAt
}